---
/**
 * ProjectPreview.astro
 * Floating visual preview canvas for the home page.
 * Shows abstract CSS art when hovering over project list items (desktop only).
 */
---

<div id="preview-canvas">
    <div id="preview-content"></div>
</div>

<style>
    #preview-canvas {
        position: absolute;
        left: 100%;
        top: 50%;
        transform: translateY(-50%) translateX(-10px);
        margin-left: 4rem;
        width: 320px;
        height: 240px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), top 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        z-index: 10;
    }

    @media (prefers-reduced-motion: reduce) {
        #preview-canvas {
            transition: none;
            transform: translateY(-50%);
        }
    }

    @media (max-width: 1000px) {
        #preview-canvas {
            display: none !important;
        }
    }

    /* Visual: M365 Copilot */
    :global(.visual-copilot) {
        width: 100%; height: 100%;
        background: var(--canvas-bg-copilot);
        display: flex; align-items: center; justify-content: center;
        view-transition-name: project-hero-copilot;
        overflow: hidden;
    }
    :global(.visual-copilot)::before {
        content: ''; width: 100px; height: 100px; border: 6px solid var(--text-main); border-radius: 20px;
        background-color: var(--canvas-fg-copilot); position: relative; z-index: 2;
    }
    :global(.visual-copilot)::after {
        content: ''; width: 50px; height: 50px; background-color: var(--accent-orange); border-radius: 50%;
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1;
        margin-top: -30px; margin-left: 30px;
    }

    /* Visual: Power Apps */
    :global(.visual-powerapps) {
        width: 100%; height: 100%;
        background: var(--canvas-bg-powerapps);
        display: flex; align-items: center; justify-content: center;
        position: relative;
        overflow: hidden;
    }
    :global(.visual-powerapps)::before {
        content: ''; width: 120px; height: 60px; background-color: var(--text-main); border-radius: 6px;
    }
    :global(.visual-powerapps)::after {
        content: ''; width: 30px; height: 30px; background-color: var(--accent-orange);
        position: absolute; bottom: 30%; right: 30%; border-radius: 4px;
    }

    /* Visual: Lobe */
    :global(.visual-lobe) {
        width: 100%; height: 100%;
        background: var(--canvas-bg-lobe);
        display: flex; align-items: center; justify-content: center;
        position: relative;
        overflow: hidden;
    }
    :global(.visual-lobe)::before {
        content: ''; width: 0; height: 0; border-left: 50px solid transparent; border-right: 50px solid transparent;
        border-bottom: 80px solid var(--text-main); position: absolute;
    }
    :global(.visual-lobe)::after {
        content: ''; width: 60px; height: 60px; border: 6px solid var(--accent-orange); border-radius: 50%;
        position: absolute; top: 25%; left: 20%;
    }

    /* Visual: Skype */
    :global(.visual-skype) {
        width: 100%; height: 100%;
        background: var(--canvas-bg-copilot);
        display: flex; align-items: center; justify-content: center;
        position: relative;
        overflow: hidden;
    }
    :global(.visual-skype)::before {
        content: ''; width: 80px; height: 80px; border: 12px solid var(--accent-orange); border-radius: 50%;
        position: relative; z-index: 2;
    }
    :global(.visual-skype)::after {
        content: ''; width: 120px; height: 12px; background-color: var(--text-main); border-radius: 6px;
        position: absolute; top: 60%; transform: rotate(-45deg); z-index: 1;
    }

    :global(.preview-state) { display: none; }
    :global(.preview-state.active) { display: block; }
</style>

<script>
    const projectLinks = document.querySelectorAll('.index-link[data-visual]');
    const previewCanvas = document.getElementById('preview-canvas') as HTMLElement;
    const previewContent = document.getElementById('preview-content') as HTMLElement;
    const container = document.querySelector('.container') as HTMLElement;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const showPreview = (target: HTMLElement) => {
        const visualType = target.getAttribute('data-visual');
        previewContent.className = `preview-state active visual-${visualType}`;

        const linkRect = target.getBoundingClientRect();
        const containerRect = container.getBoundingClientRect();
        const relativeY = linkRect.top - containerRect.top + (linkRect.height / 2);

        previewCanvas.style.top = `${relativeY}px`;
        previewCanvas.style.opacity = '1';
        previewCanvas.style.transform = prefersReducedMotion ? 'translateY(-50%)' : 'translateY(-50%) translateX(0)';
    };

    const hidePreview = () => {
        previewCanvas.style.opacity = '0';
        previewCanvas.style.transform = prefersReducedMotion ? 'translateY(-50%)' : 'translateY(-50%) translateX(-10px)';

        if (prefersReducedMotion) {
            previewContent.className = '';
            return;
        }

        setTimeout(() => {
            if (previewCanvas.style.opacity === '0') {
                previewContent.className = '';
            }
        }, 300);
    };

    if (projectLinks.length && previewCanvas && previewContent && container) {
        projectLinks.forEach(link => {
            link.addEventListener('mouseenter', (e) => showPreview(e.currentTarget as HTMLElement));
            link.addEventListener('focus', (e) => showPreview(e.currentTarget as HTMLElement));
            link.addEventListener('mouseleave', hidePreview);
            link.addEventListener('blur', hidePreview);
        });
    }
</script>
