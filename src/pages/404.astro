---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<BaseLayout title="404 - Filip Mares" noindex={true}>
    <nav class="navbar" aria-label="Page navigation" slot="nav">
        <a href="/" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Index
        </a>
        <ThemeToggle />
    </nav>

    <main class="error-container" id="main-content" tabindex="-1">
        <!-- Interactive Playful Graphic -->
        <div class="interactive-graphic">
            <div class="slot" id="target-slot"></div>
            <button class="fallen-piece" id="draggable-piece" type="button" aria-label="Click to reconnect disconnected component"></button>
        </div>

        <h1>404</h1>
        <p id="repair-status" role="status" aria-live="polite" aria-atomic="true">Component disconnected.</p>
        <div class="repair-actions">
            <a id="repair-home-link" class="repair-home-link" href="/" hidden>Home</a>
        </div>
        <div class="hint">Click the orange piece to repair.</div>
    </main>
</BaseLayout>

<style>
    :global(body) {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .error-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
    }

    .interactive-graphic {
        width: 120px;
        height: 180px;
        position: relative;
        margin-bottom: 3rem;
    }

    .slot {
        width: 60px;
        height: 60px;
        border: 4px dashed var(--border-color);
        border-radius: 50%;
        position: absolute;
        top: 0;
        left: 30px;
        transition: border-color 0.4s ease;
    }

    .fallen-piece {
        width: 60px;
        height: 60px;
        background-color: var(--accent-orange);
        border-radius: 50%;
        position: absolute;
        top: 0;
        left: 30px;
        transform: translate(20px, 120px);
        cursor: pointer;
        box-shadow: 0 4px 12px color-mix(in srgb, var(--text-main) 15%, transparent);
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .fallen-piece:hover {
        transform: translate(20px, 120px) scale(1.05);
        box-shadow: 0 6px 16px rgba(244, 91, 38, 0.3);
    }

    .fallen-piece.reconnected {
        transform: translate(0, 0);
        box-shadow: none;
        cursor: default;
    }

    .repair-actions {
        min-height: 44px;
        margin-bottom: 0.75rem;
    }

    .repair-home-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        color: var(--text-main);
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .repair-home-link:hover,
    .repair-home-link:focus-visible {
        text-decoration-color: var(--accent-orange);
    }

    @media (prefers-reduced-motion: reduce) {
        .fallen-piece {
            transition: none;
        }

        .fallen-piece:hover {
            transform: translate(20px, 120px);
            box-shadow: 0 4px 12px color-mix(in srgb, var(--text-main) 15%, transparent);
        }
    }

    h1 {
        font-size: 4rem;
        font-weight: 600;
        letter-spacing: -0.04em;
        margin-bottom: 0.5rem;
        line-height: 1;
    }

    p {
        font-size: 1.15rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }

    .hint {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        opacity: 0.7;
        margin-top: -1rem;
        margin-bottom: 2rem;
    }
</style>

<script>
    const piece = document.getElementById('draggable-piece');
    const hint = document.querySelector('.hint') as HTMLElement;
    const errorText = document.getElementById('repair-status') as HTMLElement | null;
    const homeLink = document.getElementById('repair-home-link') as HTMLAnchorElement | null;

    piece?.addEventListener('click', () => {
        if (piece.classList.contains('reconnected') || !errorText || !hint || !homeLink) return;

        if (typeof (window as any).playMechanicalClick === 'function') {
            (window as any).playMechanicalClick();
        }

        piece.classList.add('reconnected');
        piece.setAttribute('aria-disabled', 'true');
        piece.disabled = true;

        errorText.textContent = "Component repaired. Return to the index when you are ready.";
        errorText.style.color = "var(--text-main)";
        hint.style.display = "none";
        homeLink.hidden = false;
        homeLink.focus();
    });
</script>
