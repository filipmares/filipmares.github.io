---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
---

<BaseLayout
    title="Filip Mares - Software Engineer"
    description="Principal Software Engineer at Microsoft. Focused on human-computer interaction, artificial intelligence, and low-code platforms."
    ogUrl="https://filipmares.com"
>
    <!-- Home page: theme toggle is absolutely positioned (top-right) -->
    <div class="theme-toggle-wrapper" slot="nav">
        <ThemeToggle />
    </div>

    <div class="container">
        <!-- Floating Canvas for Project Hover Visuals -->
        <ProjectPreview />

        <header>
            <div class="hero-title-group">
                <h1>Filip Mares</h1>
                <div class="location-badge" id="sf-location-badge">
                    <div class="location-icon-container" id="sf-icon-container"></div>
                    San Francisco, CA
                </div>
            </div>
            <p class="bio">Principal Software Engineer at Microsoft. Building App Builder in M365 Copilot. Previously led work across Power Apps Copilot, Cards for Power Apps, and Lobe (Machine Learning Made Easy). Formerly founding engineer at Talko and Web Engineering Lead at Pulse.</p>

            <nav class="social-links" aria-label="Social links">
                <a href="/about" class="about-link" style="view-transition-name: about-link;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    About
                </a>
                <a href="https://www.linkedin.com/in/filipmares/" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                </a>
            </nav>
        </header>

        <main>
            <section>
                <h2 class="section-label">Selected Projects</h2>
                <ul class="index-list">
                    <li>
                        <a href="/projects/copilot" class="index-link" data-visual="copilot" style="view-transition-name: project-title-copilot;">
                            <span class="index-title">App Builder in M365 Copilot</span>
                            <span class="index-meta">Aug 2025 —</span>
                        </a>
                    </li>
                    <li>
                        <a href="/projects/powerapps" class="index-link" data-visual="powerapps" style="view-transition-name: project-title-powerapps;">
                            <span class="index-title">Power Apps Copilot & Collaboration</span>
                            <span class="index-meta">2021 — 2024</span>
                        </a>
                    </li>
                    <li>
                        <a href="/projects/lobe" class="index-link" data-visual="lobe" style="view-transition-name: project-title-lobe;">
                            <span class="index-title">Lobe</span>
                            <span class="index-meta">2019 — 2021</span>
                        </a>
                    </li>
                    <li>
                        <a href="/projects/skype" class="index-link" data-visual="skype" style="view-transition-name: project-title-skype;">
                            <span class="index-title">Skype Calling UI & ReactXP</span>
                            <span class="index-meta">2016 — 2019</span>
                        </a>
                    </li>
                </ul>
            </section>

            <section>
                <h2 class="section-label">Experience</h2>
                <ul class="index-list">
                    <li>
                        <div class="index-link" style="cursor: default;">
                            <span class="index-title">Microsoft</span>
                            <span class="index-meta">Jan 2016 — Present</span>
                        </div>
                    </li>
                    <li>
                        <div class="index-link" style="cursor: default;">
                            <span class="index-title">Talko</span>
                            <span class="index-meta">Apr 2013 — Jan 2016</span>
                        </div>
                    </li>
                    <li>
                        <div class="index-link" style="cursor: default;">
                            <span class="index-title">Pulse</span>
                            <span class="index-meta">Feb 2011 — Mar 2013</span>
                        </div>
                    </li>
                </ul>
            </section>
        </main>
    </div>
</BaseLayout>

<style>
    /* Home page body padding override */
    :global(body) {
        padding: 10vh 2rem;
    }

    /* Theme toggle: top-right absolute on home page */
    .theme-toggle-wrapper {
        position: absolute;
        top: 2rem;
        right: 2rem;
    }

    .container {
        max-width: 600px;
        margin: 0 auto;
        position: relative; /* Anchor for the absolute positioned preview canvas */
    }

    /* Typography */
    .hero-title-group {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1rem;
    }

    h1 {
        font-size: 2.5rem;
        font-weight: 500;
        letter-spacing: -0.03em;
        margin-bottom: 0;
        display: inline-flex;
        align-items: center;
    }

    /* Location Badge */
    .location-badge {
        display: inline-flex;
        align-items: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .location-icon-container {
        width: 16px;
        height: 16px;
        margin-right: 0.4rem;
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .location-badge :global(svg) {
        width: 16px;
        height: 16px;
        color: var(--accent-orange);
        stroke-width: 1.5;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .location-badge :global(svg.active) {
        opacity: 1;
        transform: translateY(0);
    }

    .location-badge :global(svg.leaving) {
        opacity: 0;
        transform: translateY(-4px);
    }

    /* Bio */
    .bio {
        font-size: 1.15rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
        max-width: 90%;
    }

    .bio a {
        color: var(--text-main);
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 1px;
        text-decoration-color: var(--text-muted);
        transition: color 0.2s, text-decoration-color 0.2s;
    }

    .bio a:hover {
        color: var(--accent-orange);
        text-decoration-color: var(--accent-orange);
    }

    /* Social Links */
    .social-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 4rem;
    }

    .social-link {
        display: flex;
        align-items: center;
        color: var(--text-main);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .social-link :global(svg) {
        width: 20px;
        height: 20px;
        transition: transform 0.2s ease, filter 0.2s ease;
    }

    .social-link:hover {
        color: var(--accent-orange);
    }

    .social-link:hover :global(svg) {
        transform: translateY(-2px);
        filter: drop-shadow(0 4px 6px rgba(244, 91, 38, 0.2));
    }

    /* About link */
    .about-link {
        display: flex;
        align-items: center;
        color: var(--text-main);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition: color 0.2s ease;
        margin-right: auto;
    }

    .about-link :global(svg) {
        width: 16px;
        height: 16px;
        margin-right: 0.5rem;
        transition: transform 0.2s ease;
    }

    .about-link:hover {
        color: var(--accent-orange);
    }

    .about-link:hover :global(svg) {
        transform: translateX(4px);
    }

    /* Section Titles */
    h2.section-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--text-muted);
        margin-bottom: 2rem;
        margin-top: 5rem;
    }

    /* Index List (Projects & Experience) */
    ul.index-list {
        list-style: none;
    }

    ul.index-list li {
        border-bottom: 1px solid rgba(0,0,0,0.1);
        transition: border-color 0.4s ease;
    }

    ul.index-list li:first-child {
        border-top: 1px solid rgba(0,0,0,0.1);
    }

    :global(:root.dark-theme) ul.index-list li {
        border-color: rgba(255, 255, 255, 0.1);
    }
    :global(:root.dark-theme) ul.index-list li:first-child {
        border-top-color: rgba(255, 255, 255, 0.1);
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not(.light-theme)) ul.index-list li {
            border-color: rgba(255, 255, 255, 0.1);
        }
        :global(:root:not(.light-theme)) ul.index-list li:first-child {
            border-top-color: rgba(255, 255, 255, 0.1);
        }
    }

    .index-link {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 1.25rem 0;
        text-decoration: none;
        color: var(--text-main);
        transition: padding-left 0.3s ease;
        position: relative;
    }

    /* Subtle orange bar indicator on hover */
    .index-link::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        background-color: var(--accent-orange);
        transition: height 0.2s ease;
    }

    a.index-link:hover::before {
        height: 50%;
    }

    a.index-link:hover {
        padding-left: 1.25rem;
        color: var(--text-main);
    }

    .index-title {
        font-size: 1.25rem;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    .index-meta {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-variant-numeric: tabular-nums;
        text-align: right;
        transition: color 0.3s ease;
    }

    a.index-link:hover .index-meta {
        color: var(--accent-orange);
    }

    /* Responsive */
    @media (max-width: 600px) {
        :global(body) {
            padding: 5vh 1.5rem;
        }

        .hero-title-group {
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        h1 {
            font-size: 2rem;
        }

        .bio {
            font-size: 1rem;
            max-width: 100%;
        }

        .index-link {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            padding: 1rem 0;
        }

        .index-meta {
            text-align: left;
            font-size: 0.8rem;
        }

        a.index-link:hover {
            padding-left: 0;
        }

        .social-links {
            gap: 1rem;
            flex-wrap: wrap;
        }
    }
</style>

<script>
    // Random SF Icon Injector
    const sfIcons = [
        // Sutro Tower
        `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2h14"></path><path d="M6 2l3 20"></path><path d="M18 2l-3 20"></path><path d="M7 8h10"></path><path d="M8 15h8"></path><path d="M12 2v20"></path><path d="M6 2l6 6"></path><path d="M18 2l-6 6"></path></svg>`,
        // Transamerica Pyramid
        `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L6 22h12L12 2z"></path><path d="M12 2v20"></path><path d="M9.5 12h5"></path><path d="M8 17h8"></path></svg>`,
        // Golden Gate Bridge
        `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V6M18 22V6"></path><path d="M2 14c3-4 6-6 10-6s7 2 10 6"></path><path d="M6 10v4M18 10v4"></path><path d="M2 14h20"></path></svg>`,
        // Cable Car
        `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="6" width="16" height="12" rx="2"></rect><path d="M4 12h16"></path><path d="M8 6v6"></path><path d="M16 6v6"></path><circle cx="8" cy="18" r="2"></circle><circle cx="16" cy="18" r="2"></circle><path d="M12 2v4"></path></svg>`,
        // Fog over water
        `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 19h8"></path><path d="M5 15h14"></path><path d="M6 11h11a3 3 0 0 0-3-3 4 4 0 0 0-7 2 2 2 0 0 0-1 3z"></path></svg>`
    ];

    const iconContainer = document.getElementById('sf-icon-container');

    if (iconContainer) {
        // Inject all icons but keep them hidden
        iconContainer.innerHTML = sfIcons.join('');
        const svgElements = iconContainer.querySelectorAll('svg');

        let currentIconIndex = Math.floor(Math.random() * sfIcons.length);
        svgElements[currentIconIndex].classList.add('active');

        // Cycle through icons every 3 seconds
        setInterval(() => {
            const oldIndex = currentIconIndex;
            currentIconIndex = (currentIconIndex + 1) % sfIcons.length;

            const oldSvg = svgElements[oldIndex];
            const newSvg = svgElements[currentIconIndex];

            oldSvg.classList.remove('active');
            oldSvg.classList.add('leaving');

            newSvg.classList.add('active');

            // Clean up leaving class after animation completes
            setTimeout(() => {
                oldSvg.classList.remove('leaving');
            }, 500);
        }, 3000);
    }
</script>
