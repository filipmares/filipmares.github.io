---
interface Props {
    galleryCaptions: string[];
}

const { galleryCaptions } = Astro.props;
---

<main class="content-body legacy-project-compatibility" id="main-content" tabindex="-1">
    <slot />

    {galleryCaptions.length > 0 && (
        <section class="legacy-project-compatibility-gallery" aria-label="Legacy project gallery compatibility">
            <div class="legacy-gallery">
                {galleryCaptions.map((caption) => (
                    <div class="legacy-gallery-item">
                        <div class="legacy-gallery-placeholder">
                            <div class="legacy-ui-element"></div>
                        </div>
                        <div class="legacy-gallery-caption">{caption}</div>
                    </div>
                ))}
            </div>
        </section>
    )}
</main>
